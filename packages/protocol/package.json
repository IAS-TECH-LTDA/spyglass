{
  "name": "spyglass-protocol",
  "version": "0.1.1",
  "description": "Shared message types and helpers for the Spyglass SDK <-> Desktop WebSocket protocol.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node -e \"require('fs').accessSync('dist/index.js')\""
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Italo Souza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/italosouza/spyglass.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/italosouza/spyglass#readme",
  "bugs": {
    "url": "https://github.com/italosouza/spyglass/issues"
  },
  "keywords": ["spyglass", "react-native", "expo", "devtools", "protocol"],
  "publishConfig": {
    "access": "public"
  }
}
